{
  "expo": {
    "name": "Calm Work",
    "slug": "calm-work",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "calmwork",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF8A80"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.calmwork.app"
    },
    "android": {
      "package": "com.calmwork.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF8A80"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
