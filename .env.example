# Copy to .env and fill in when you connect a real backend.
# Restart Expo after changing env vars (they are inlined at build time).

# Set to "true" only after your API is live and AppConfig.USE_REMOTE_API is true
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/v1

EXPO_PUBLIC_API_URL=https://api.calmwork.app/v1
